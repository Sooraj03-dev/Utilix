# Shared secret; must match AI_SERVICE_SECRET in the root .env
AI_SERVICE_SECRET=change-me

# LLM provider key. Leave EMPTY to force the deterministic fallback
# (templated explanations, source: "fallback"). Used for demo step 7.
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=6000
AI_MAX_RETRIES=1

# Allowed origins, comma separated
CORS_ORIGINS=http://localhost:3000

# Seed for the lottery tie-breaker when none is supplied
DEFAULT_TIEBREAK_SEED=utilix
