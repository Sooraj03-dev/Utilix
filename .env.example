# ===== Firebase client (safe to expose to the browser) =====
# Firebase console > Project settings > Your apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# true = use local Firebase emulators (Auth 9099, Firestore 8080)
NEXT_PUBLIC_USE_EMULATORS=true
# true = run fully isolated local mock-auth accounts (never for production)
NEXT_PUBLIC_USE_MOCK_AUTH=false

# ===== Firebase admin (SERVER ONLY, never prefix with NEXT_PUBLIC) =====
# Firebase console > Project settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes and the literal \n sequences
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Emulator hosts (used only when NEXT_PUBLIC_USE_EMULATORS=true)
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# ===== AI service (FastAPI) =====
AI_SERVICE_URL=http://localhost:8000
# Must match AI_SERVICE_SECRET in /ai-service/.env
AI_SERVICE_SECRET=change-me
# Timeout in ms for calls from Next.js to the AI service
AI_SERVICE_TIMEOUT_MS=6000

# ===== App =====
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Seed script safety: refuse to run against production unless true
ALLOW_SEED=false
# Comma-separated Firebase project IDs allowed for SEED_TARGET=demo
SEED_DEV_PROJECT_ALLOWLIST=utilix-dev
